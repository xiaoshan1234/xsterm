{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "*": "allow"
    }
  },
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "npx",
        "-y",
        "@playwright/mcp",
        "--browser",
        "chromium",
        "--executable-path",
        "/home/loner/.cache/ms-playwright/chromium-1234/chrome-linux64/chrome",
        "--headless",
        "--no-sandbox"
      ]
    }
  }
}